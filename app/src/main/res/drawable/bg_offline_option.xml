<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/offline_accent_stroke">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#0DFFB84D"
                android:startColor="@color/offline_accent_soft" />
            <stroke
                android:width="1.2dp"
                android:color="@color/offline_accent_stroke" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</ripple>
