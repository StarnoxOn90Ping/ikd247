<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="streak_label" translatable="false">day streak</string>

    <!-- Short on purpose: they sit in a small 2-3 line slot in the Home header. -->

    <!-- never started / streak too short to mourn -->
    <string-array name="streak_lines_none" translatable="false">
        <item>Light the first flame today.</item>
        <item>Finish one episode or chapter.</item>
        <item>It\'s cold in here. Start a fire.</item>
        <item>Zero days. Only way is up.</item>
    </string-array>

    <string-array name="streak_lines_day1" translatable="false">
        <item>Day one. Legends start here.</item>
        <item>The first spark. Guard it.</item>
        <item>One down. Couch is proud.</item>
    </string-array>

    <string-array name="streak_lines_early" translatable="false">
        <item>A few in a row. Dangerous.</item>
        <item>Becoming a habit. Uh oh.</item>
        <item>Look at you, consistent.</item>
        <item>The flame grows. Keep going.</item>
    </string-array>

    <string-array name="streak_lines_week" translatable="false">
        <item>A whole week. Touch grass? Nah.</item>
        <item>Seven days. The buttons caught fire.</item>
        <item>You\'re literally on fire.</item>
    </string-array>

    <string-array name="streak_lines_fortnight" translatable="false">
        <item>Two weeks. Sleep is optional.</item>
        <item>A lifestyle, not a streak.</item>
        <item>Dedication. And screen time.</item>
    </string-array>

    <string-array name="streak_lines_month" translatable="false">
        <item>30 days. Watchlist is shaking.</item>
        <item>Maximum fire reached. You did that.</item>
        <item>A month of flames. Respect.</item>
    </string-array>

    <string-array name="streak_lines_legend" translatable="false">
        <item>Absolute legend. Cat\'s impressed.</item>
        <item>Your flame has its own gravity.</item>
        <item>Main character energy. Hydrate.</item>
    </string-array>

    <!-- alive, but nothing finished today yet -->
    <string-array name="streak_lines_at_risk" translatable="false">
        <item>Flickering. One episode saves it.</item>
        <item>Nothing yet today. Fire\'s hungry.</item>
        <item>Quick, an episode before it dies.</item>
        <item>Streak at risk. Not a drill.</item>
    </string-array>

    <!-- yesterday missed, grace day will cover it -->
    <string-array name="streak_lines_grace" translatable="false">
        <item>Missed yesterday. Grace day\'s ready.</item>
        <item>Grace day on standby. Watch something.</item>
        <item>Close call. Grace day has your back.</item>
    </string-array>

    <!-- streak of 3+ just broke -->
    <string-array name="streak_lines_lost" translatable="false">
        <item>Streak out. We don\'t talk about it.</item>
        <item>Fresh start. The cat forgives you.</item>
        <item>Happens to the best. Relight it.</item>
        <item>The flame went out. Try again.</item>
    </string-array>

    <!-- Settings > Streak -->
