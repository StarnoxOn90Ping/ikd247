<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="24dp">

    <LinearLayout
        android:id="@+id/offlineCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_offline_dialog"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:padding="22dp">

        <FrameLayout
            android:layout_width="72dp"
            android:layout_height="72dp">

            <View
                android:id="@+id/offlineDialogPulse"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_offline_pulse" />

            <ImageView
                android:id="@+id/offlineDialogIcon"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wifi_off_24"
                app:tint="@color/offline_accent" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="@font/poppins_bold"
            android:text="@string/offline_dialog_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:alpha="0.7"
            android:fontFamily="@font/poppins"
            android:gravity="center"
            android:text="@string/offline_dialog_message"
            android:textColor="?attr/colorOnSurface"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/offlineTryAgain"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/bg_offline_primary"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:text="@string/offline_dialog_try_again"
            android:textColor="#1A1A1A"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/offlineCachedOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_offline_option"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/offline_dialog_cached"
                android:textColor="@color/offline_accent"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:fontFamily="@font/poppins"
                android:text="@string/offline_dialog_cached_hint"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/offlineDownloadsOption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_offline_option"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="@string/offline_dialog_downloads"
                android:textColor="@color/offline_accent"
                android:textSize="14sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:alpha="0.65"
                android:fontFamily="@font/poppins"
                android:text="@string/offline_dialog_downloads_hint"
                android:textColor="?attr/colorOnSurface"
                android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
