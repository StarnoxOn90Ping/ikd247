<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="64dp"
        android:paddingEnd="32dp"
        android:paddingBottom="120dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="240dp"
            android:layout_height="240dp"
            android:clipChildren="false">

            <!-- soft white light behind the icon -->
            <View
                android:id="@+id/iconGlow"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_onboarding_glow" />

            <ImageView
                android:id="@+id/pageIcon"
                android:layout_width="128dp"
                android:layout_height="128dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/pageEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/kanit_medium"
            android:letterSpacing="0.28"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/kanit_semibold"
            android:gravity="center"
            android:lineSpacingExtra="-2dp"
            android:shadowColor="#80000000"
            android:shadowDy="3"
            android:shadowRadius="12"
            android:textColor="#FFFFFF"
            android:textSize="34sp" />

        <TextView
            android:id="@+id/pageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/kanit_light"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:shadowColor="#80000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="#F2FFFFFF"
            android:textSize="17sp" />

        <!-- disclaimer highlight -->
        <TextView
            android:id="@+id/noteCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_onboarding_chip"
            android:drawableStart="@drawable/ic_onboarding_check"
            android:drawablePadding="12dp"
            android:drawableTint="#7CFFB2"
            android:fontFamily="@font/kanit_medium"
            android:gravity="center_vertical"
            android:lineSpacingExtra="2dp"
            android:padding="18dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <!-- unified permissions checklist -->
        <LinearLayout
            android:id="@+id/permissionList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical"
            android:visibility="gone" />

        <!-- theme picker -->
        <GridLayout
            android:id="@+id/themeGrid"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:columnCount="5"
            android:visibility="gone" />

        <TextView
            android:id="@+id/themeName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/kanit_semibold"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/themeHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/kanit_light"
            android:gravity="center"
            android:text="@string/onboarding_themes_hint"
            android:textColor="#B3FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_onboarding_chip"
            android:drawablePadding="8dp"
            android:fontFamily="@font/kanit_medium"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="18dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/kanit_semibold"
            android:minWidth="220dp"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="gone"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="27dp"
            app:strokeColor="#B3FFFFFF"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
