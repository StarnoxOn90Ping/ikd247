<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="64dp"
        android:paddingEnd="32dp"
        android:paddingBottom="120dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="260dp"
            android:layout_height="260dp">

            <ani.dantotsu.onboarding.OrbitalIconView
                android:id="@+id/orbital"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ImageView
                android:id="@+id/pageIcon"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/pageEyebrow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:letterSpacing="0.22"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:letterSpacing="-0.02"
            android:lineSpacingExtra="-2dp"
            android:shadowColor="#66000000"
            android:shadowDy="4"
            android:shadowRadius="14"
            android:textColor="#FFFFFF"
            android:textSize="31sp" />

        <TextView
            android:id="@+id/pageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_family"
            android:gravity="center"
            android:lineSpacingExtra="5dp"
            android:shadowColor="#40000000"
            android:shadowDy="2"
            android:shadowRadius="8"
            android:textColor="#E6FFFFFF"
            android:textSize="15sp" />

        <LinearLayout
            android:id="@+id/featureRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone" />

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_onboarding_chip"
            android:drawablePadding="8dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            android:layout_width="wrap_content"
            android:layout_height="54dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:minWidth="220dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="27dp"
            app:strokeColor="#B3FFFFFF"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
