<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/pageContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingTop="72dp"
        android:paddingEnd="32dp"
        android:paddingBottom="120dp">

        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="200dp"
            android:layout_height="200dp">

            <View
                android:id="@+id/pulseRing"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_onboarding_ring" />

            <View
                android:layout_width="150dp"
                android:layout_height="150dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_onboarding_circle" />

            <ImageView
                android:id="@+id/pageIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <TextView
            android:id="@+id/pageTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="36dp"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:textColor="#FFFFFF"
            android:textSize="26sp" />

        <TextView
            android:id="@+id/pageDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:fontFamily="@font/poppins_family"
            android:gravity="center"
            android:lineSpacingExtra="4dp"
            android:textColor="#D9FFFFFF"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/statusChip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_onboarding_chip"
            android:drawablePadding="8dp"
            android:fontFamily="@font/poppins_semi_bold"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/actionButton"
            android:layout_width="wrap_content"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/poppins_bold"
            android:minWidth="200dp"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:visibility="gone"
            app:backgroundTint="#33FFFFFF"
            app:cornerRadius="26dp"
            app:strokeColor="#99FFFFFF"
            app:strokeWidth="1.5dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
