<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/windowBackground">

    <View
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:background="@drawable/bg_hub_header_glow" />

    <LinearLayout
        android:id="@+id/calendarRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="14dp">

            <FrameLayout
                android:id="@+id/calendarBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bottom_circle"
                android:clickable="true"
                android:contentDescription="@string/hub_back"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_round_arrow_back_ios_new_24"
                    app:tint="?attr/colorOnBackground" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/release_calendar"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="26sp" />

                <TextView
                    android:id="@+id/calendarMonth"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.7"
                    android:fontFamily="@font/poppins"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="12sp"
                    tools:text="October 2026" />
            </LinearLayout>

            <TextView
                android:id="@+id/calendarToday"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:background="@drawable/bg_segment_track"
                android:clickable="true"
                android:elevation="4dp"
                android:focusable="true"
                android:fontFamily="@font/poppins_bold"
                android:foreground="@drawable/ripple_rounded"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:text="@string/cal_today"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp" />

            <FrameLayout
                android:id="@+id/calendarCustomize"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bottom_circle"
                android:clickable="true"
                android:contentDescription="@string/cal_customize"
                android:elevation="4dp"
                android:focusable="true"
                android:foreground="@drawable/ripple_circle">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_round_tune_24"
                    app:tint="?attr/colorPrimary" />
            </FrameLayout>
        </LinearLayout>

        <!-- Summary -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/calendarSummaryCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="20dp"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="24dp"
            app:cardElevation="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="18dp"
                android:paddingVertical="14dp">

                <TextView
                    android:id="@+id/calendarSummaryTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="15sp"
                    tools:text="3 episodes today" />

                <TextView
                    android:id="@+id/calendarSummarySub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.8"
                    android:ellipsize="end"
                    android:fontFamily="@font/poppins"
                    android:maxLines="2"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textSize="12sp"
                    tools:text="Next up: Example Anime · Ep 5 · in 2h 20m" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Day strip -->
        <HorizontalScrollView
            android:id="@+id/calendarStripScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="20dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/calendarStrip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/calendarList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:overScrollMode="never"
                android:paddingBottom="32dp" />

            <ProgressBar
                android:id="@+id/calendarProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/calendarEmpty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="40dp"
                android:visibility="gone">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:alpha="0.5"
                    android:importantForAccessibility="no"
                    app:srcCompat="@drawable/ic_round_calendar_today_24"
                    app:tint="?attr/colorPrimary" />

                <TextView
                    android:id="@+id/calendarEmptyTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:fontFamily="@font/poppins_bold"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/calendarEmptyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:alpha="0.7"
                    android:fontFamily="@font/poppins"
                    android:gravity="center"
                    android:textColor="?attr/colorOnBackground"
                    android:textSize="13sp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/calendarEmptyAction"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/cal_customize" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
