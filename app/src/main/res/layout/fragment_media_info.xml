<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:cardBackgroundColor="?android:colorBackground"
    app:cardCornerRadius="0dp"
    app:cardElevation="0dp"
    tools:context=".media.MediaInfoFragment"
    tools:ignore="SpeakableTextPresentCheck">

    <ani.dantotsu.util.BounceNestedScrollView

        android:id="@+id/mediaInfoScroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ProgressBar
                android:id="@+id/mediaInfoProgressBar"
                style="?android:attr/progressBarStyle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="32dp"
                android:indeterminate="true"
                android:visibility="gone"
                tools:visibility="gone" />

            <LinearLayout
                android:id="@+id/mediaInfoContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Stats bar: score, popularity, favourites, duration (+ airing line) -->
                <LinearLayout
                    android:id="@+id/mediaStatsCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="32dp"
                    android:background="@drawable/bg_media_stats_card"
                    android:orientation="vertical"
                    android:paddingStart="8dp"
                    android:paddingTop="11dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <Space
                                    android:id="@+id/mediaStatSpacer0"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="0.6" />

                                <LinearLayout
                            android:id="@+id/mediaStatScoreColumn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="top|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mediaStatScore"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/manrope_bold"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="18sp"
                                        android:translationY="2dp"
                                tools:text="8.2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:fontFamily="@font/poppins_bold"
                                android:singleLine="true"
                                android:text="@string/stats_score"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Space
                                    android:id="@+id/mediaStatSpacer1"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                            android:id="@+id/mediaStatPopularityColumn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="top|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mediaStatPopularity"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/manrope_bold"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="18sp"
                                        android:translationY="2dp"
                                tools:text="8.2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:fontFamily="@font/poppins_bold"
                                android:singleLine="true"
                                android:text="@string/popularity"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Space
                                    android:id="@+id/mediaStatSpacer2"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                            android:id="@+id/mediaStatFavoritesColumn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="top|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mediaStatFavorites"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/manrope_bold"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="18sp"
                                        android:translationY="2dp"
                                tools:text="8.2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:fontFamily="@font/poppins_bold"
                                android:singleLine="true"
                                android:text="@string/favourites"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <Space
                                    android:id="@+id/mediaStatSpacer3"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="1" />

                                <LinearLayout
                            android:id="@+id/mediaStatDurationColumn"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="top|center_horizontal"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/mediaStatDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:includeFontPadding="false"
                                android:fontFamily="@font/manrope_bold"
                                android:singleLine="true"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="18sp"
                                        android:translationY="2dp"
                                tools:text="8.2" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:alpha="0.6"
                                android:fontFamily="@font/poppins_bold"
                                android:singleLine="true"
                                android:text="@string/stats_duration"
                                android:textColor="?attr/colorOnBackground"
                                android:textSize="11sp" />
                        </LinearLayout>

                                <Space
                                    android:id="@+id/mediaStatSpacer4"
                                    android:layout_width="0dp"
                                    android:layout_height="0dp"
                                    android:layout_weight="0.6" />

                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaAiringRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginTop="10dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:layout_marginEnd="8dp"
                            android:src="@drawable/ic_airing_sensors"
                            app:tint="?attr/colorPrimary"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:id="@+id/mediaAiringText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/poppins_bold"
                            android:singleLine="true"
                            android:textColor="?attr/colorOnBackground"
                            android:textSize="14sp"
                            tools:text="Episode 5 airs in 3d 1h" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Synopsis: first thing on the Info tab -->
                <LinearLayout
                    android:id="@+id/mediaInfoSynopsis"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="20dp"
                    android:paddingEnd="32dp"
                    android:paddingBottom="4dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/mediaInfoDescriptionText"
                            android:translationX="-2dp"
                            android:translationY="3dp"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:includeFontPadding="false"
                            android:fontFamily="@font/poppins_bold"
                            android:text="@string/description"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="20sp" />

                        <ImageView
                            android:id="@+id/mediaInfoTts"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:layout_marginEnd="-6dp"
                            android:alpha="0.7"
                            android:padding="6dp"
                            android:src="@drawable/ic_record_voice_over"
                            app:tint="?attr/colorOnBackground"
                            tools:ignore="ContentDescription" />
                    </LinearLayout>

                    <ani.dantotsu.media.FadingTextView
                        android:id="@+id/mediaInfoDescription"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:maxLines="5"
                        android:text="@string/description"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/mediaInfoReadMore"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:background="?attr/selectableItemBackground"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:paddingTop="2dp"
                        android:paddingBottom="4dp"
                        android:text="@string/read_more"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="14sp"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Details: two-column grid, label above value -->
                <LinearLayout
                    android:id="@+id/mediaInfoDetailsTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="0dp">

                    <TextView
                        android:id="@+id/mediaInfoDetailsTitle"
                        android:translationX="-2dp"
                        android:translationY="3dp"
                        android:includeFontPadding="false"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:text="@string/details"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp" />

                    <GridLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:columnCount="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/mediaInfoTotalTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/total_eps"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoTotal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="4 | ~" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/format"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoFormat"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="Tv" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/source"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoSource"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="Other" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaInfoStudioContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/main_studio"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoStudio"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="Toei Animation" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaInfoAuthorContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/author"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoAuthor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="Akira Toriyama" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/mediaInfoSeasonContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/season"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoSeason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="Fall 2026" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/country"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoCountry"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="JP" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginBottom="10dp"
                        android:layout_marginEnd="12dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:alpha="0.58"
                            android:text="@string/aired"
                            android:includeFontPadding="false"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/mediaInfoStart"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="1dp"
                            android:fontFamily="@font/poppins_bold"
                            android:maxLines="2"
                            android:ellipsize="end"
                            android:includeFontPadding="false"
                            android:textSize="15sp"
                            tools:text="11 October 2026" />
                    </LinearLayout>

                    </GridLayout>
                </LinearLayout>

                <!-- Names: English / romaji / preferred -->
                <LinearLayout
                    android:id="@+id/mediaInfoNamesSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="32dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="32dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:fontFamily="@font/poppins_bold"
                        android:includeFontPadding="false"
                        android:text="@string/names"
                        android:textColor="?attr/colorPrimary"
                        android:textSize="20sp"
                        android:translationX="-2dp"
                        android:translationY="3dp" />

            <LinearLayout
                android:id="@+id/mediaInfoNameContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.58"
                    android:includeFontPadding="false"
                    android:text="@string/name"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mediaInfoName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:breakStrategy="balanced"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    tools:targetApi="m"
                    tools:text="Dragon Ball Daima" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mediaInfoNameRomajiContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.58"
                    android:includeFontPadding="false"
                    android:text="@string/name_romaji"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mediaInfoNameRomaji"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:breakStrategy="balanced"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    tools:targetApi="m"
                    tools:text="Dragon Ball Daima" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/mediaInfoNamePreferredContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.58"
                    android:includeFontPadding="false"
                    android:text="@string/name_preferred"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/mediaInfoNamePreferred"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:breakStrategy="balanced"
                    android:fontFamily="@font/poppins_bold"
                    android:includeFontPadding="false"
                    android:textSize="15sp"
                    tools:targetApi="m"
                    tools:text="Dragon Ball Daima" />
            </LinearLayout>

                </LinearLayout>

                <TextView
                    android:id="@+id/mediaNextChapterPredictionText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/next_chapter_prediction"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mediaNextChapterPrediction"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:ellipsize="end"
                    android:maxLines="5"
                    android:padding="16dp"
                    android:text="Chap: ??"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/mediaAnimeAdaptationText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="32dp"
                    android:fontFamily="@font/poppins_bold"
                    android:text="@string/anime_adaptation"
                    android:textSize="16sp"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mediaAnimeAdaptation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="16dp"
                    android:ellipsize="end"
                    android:maxLines="5"
                    android:padding="16dp"
                    android:text="Starts: ??"
                    android:visibility="gone"
                    tools:ignore="HardcodedText" />


            </LinearLayout>
        </FrameLayout>
    </ani.dantotsu.util.BounceNestedScrollView>
</androidx.cardview.widget.CardView>
