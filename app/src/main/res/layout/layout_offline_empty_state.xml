<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/offlineEmptyState"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:paddingStart="40dp"
    android:paddingTop="24dp"
    android:paddingEnd="40dp"
    android:paddingBottom="64dp"
    android:visibility="gone"
    tools:visibility="visible">

    <!-- Soft outer ring + inner filled circle holding the icon -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="124dp"
        android:layout_height="124dp"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="62dp"
        app:cardElevation="0dp"
        app:strokeColor="?attr/colorPrimary"
        app:strokeWidth="1dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:layout_gravity="center"
            app:cardBackgroundColor="?attr/colorPrimaryContainer"
            app:cardCornerRadius="48dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/offlineEmptyIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                app:tint="?attr/colorOnPrimaryContainer"
                tools:src="@drawable/ic_round_video_library_24" />
        </com.google.android.material.card.MaterialCardView>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:id="@+id/offlineEmptyTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="@font/poppins_bold"
        android:gravity="center"
        android:textColor="?attr/colorOnSurface"
        android:textSize="20sp"
        tools:text="Nothing here yet" />

    <View
        android:layout_width="36dp"
        android:layout_height="3dp"
        android:layout_marginTop="10dp"
        android:background="?attr/colorPrimary"
        android:alpha="0.6" />

    <TextView
        android:id="@+id/offlineEmptySubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:alpha="0.65"
        android:fontFamily="@font/poppins_semi_bold"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        android:maxWidth="300dp"
        android:textColor="?attr/colorOnSurface"
        android:textSize="13sp"
        tools:text="Downloaded episodes will show up here." />
</LinearLayout>
